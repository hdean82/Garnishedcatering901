{
  "name": "garnishedcatering901",
  "compatibility_date": "2026-11-22",
  "build": {
    "command": "python3 scripts/prepare-cloudflare-release.py"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "garnishedcatering.com",
      "custom_domain": true
    }
  ]
}
